---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout
  title="Message envoyé — AD Sophrologie"
  description="Votre message a bien été envoyé à Amandine Dabrowski, sophrologue."
  noindex
>
  <Header />
  <main id="contenu">
    <section class="section-padding">
      <div class="container-site max-w-xl text-center">
        <h1 class="text-3xl font-medium text-sage-900 sm:text-4xl">Merci pour votre message</h1>
        <p class="mt-4 text-lg text-sage-700">
          Votre demande a bien été transmise. Je reviens vers vous dans les meilleurs délais.
        </p>
        <div class="mt-8">
          <Button href="/">Retour à l'accueil</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
