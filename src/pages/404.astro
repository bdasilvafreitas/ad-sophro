---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Button from "@/components/Button.astro";
---

<BaseLayout title="Page introuvable — AD Sophrologie" description="Cette page n'existe pas ou plus." noindex>
  <Header />
  <main id="contenu">
    <section class="section-padding">
      <div class="container-site max-w-xl text-center">
        <p class="font-script text-6xl text-sand-700">404</p>
        <h1 class="mt-4 text-3xl font-medium text-sage-900 sm:text-4xl">Page introuvable</h1>
        <p class="mt-4 text-lg text-sage-700">
          La page que vous cherchez n'existe pas ou a été déplacée.
        </p>
        <div class="mt-8">
          <Button href="/">Retour à l'accueil</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
