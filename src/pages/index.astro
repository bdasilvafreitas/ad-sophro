---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/sections/Hero.astro";
import About from "@/components/sections/About.astro";
import WhatIsSophrology from "@/components/sections/WhatIsSophrology.astro";
import Benefits from "@/components/sections/Benefits.astro";
import SessionFormats from "@/components/sections/SessionFormats.astro";
import Pricing from "@/components/sections/Pricing.astro";
import PracticalInfo from "@/components/sections/PracticalInfo.astro";
import Faq from "@/components/sections/Faq.astro";
import CtaBanner from "@/components/sections/CtaBanner.astro";
import Contact from "@/components/sections/Contact.astro";
import Button from "@/components/Button.astro";
import { SITE } from "@/data/site";

const title = "AD Sophrologie — Amandine Dabrowski, sophrologue en Haute-Savoie & à Genève";
const description =
  "Séances de sophrologie avec Amandine Dabrowski pour mieux gérer votre stress, vos émotions et retrouver confiance en vous, en Haute-Savoie et à Genève.";
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="contenu">
    <Hero />
    <About />
    <WhatIsSophrology />
    <Benefits />
    <SessionFormats />
    <Pricing />

    <section class="pb-16 sm:pb-20">
      <div class="container-site">
        <div
          class="flex flex-col items-center justify-between gap-6 rounded-2xl border border-sage-200 bg-cream-50 p-8 text-center sm:flex-row sm:text-left"
        >
          <div>
            <h2 class="text-xl font-medium text-sage-900">Vous représentez une entreprise ?</h2>
            <p class="mt-1 text-sage-700">
              Ateliers, cycles de séances et conférences pour accompagner vos équipes.
            </p>
          </div>
          <Button href="/entreprises" variant="ghost" class="shrink-0">
            Découvrir l'offre entreprises
          </Button>
        </div>
      </div>
    </section>

    <PracticalInfo />
    <Faq />
    <CtaBanner />
    <Contact />
  </main>
  <Footer />

  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ProfessionalService",
      name: SITE.businessName,
      description,
      founder: {
        "@type": "Person",
        name: SITE.practitionerName,
        jobTitle: "Sophrologue",
      },
      areaServed: SITE.zone,
      url: SITE.siteUrl,
      // __A_COMPLETER__ : ajouter address, telephone et openingHoursSpecification
      // dès que ces informations seront disponibles, pour renforcer le SEO local.
    })}
  />
</BaseLayout>
