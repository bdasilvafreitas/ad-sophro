---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
  level?: "h2" | "h3";
}

const { eyebrow, title, description, align = "center", level = "h2" } = Astro.props;
const Tag = level;
---

<div class:list={["max-w-2xl", align === "center" ? "mx-auto text-center" : "text-left"]}>
  {
    eyebrow && (
      <p class="mb-3 font-sans text-xs font-semibold tracking-[0.25em] text-sand-800 uppercase">
        {eyebrow}
      </p>
    )
  }
  <Tag class:list={[level === "h2" ? "text-3xl sm:text-4xl" : "text-2xl", "font-medium"]}>
    {title}
  </Tag>
  {description && <p class="mt-4 text-lg text-sage-700">{description}</p>}
</div>
