---
import Button from "@/components/Button.astro";
import { SITE } from "@/data/site";
---

<section class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-sage-100 blur-2xl"></div>
    <div class="absolute top-1/3 -left-32 h-72 w-72 rounded-full bg-sand-100 blur-2xl"></div>
  </div>

  <div class="container-site py-20 sm:py-28 lg:py-32">
    <div class="max-w-2xl">
      <p class="mb-5 font-sans text-xs font-semibold tracking-[0.25em] text-sand-800 uppercase">
        Entreprises
      </p>
      <h1 class="text-4xl leading-tight font-medium text-sage-900 sm:text-5xl">
        La sophrologie au service de vos équipes
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-sage-700">
        Ateliers, cycles de séances ou conférences de sensibilisation : {SITE.practitionerName}{" "}
        accompagne vos collaborateurs dans la gestion du stress et la qualité de vie au travail, en{" "}
        {SITE.zone}.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href="/#contact" variant="primary">Demander un devis</Button>
        <Button href="#formats" variant="ghost">Découvrir les formats</Button>
      </div>
    </div>
  </div>
</section>
