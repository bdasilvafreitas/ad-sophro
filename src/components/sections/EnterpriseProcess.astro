---
import SectionHeading from "@/components/SectionHeading.astro";
import { BUSINESS_STEPS } from "@/data/business";
---

<section class="section-padding bg-sage-50">
  <div class="container-site">
    <SectionHeading eyebrow="Le déroulement" title="Comment ça se passe ?" />

    <ol class="mt-16 grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      {
        BUSINESS_STEPS.map((step, index) => (
          <li class="rounded-2xl border border-sage-200 bg-cream-50 p-6">
            <span class="font-script text-4xl text-sand-700">{index + 1}</span>
            <h3 class="mt-2 text-lg font-medium text-sage-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-sage-700">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
