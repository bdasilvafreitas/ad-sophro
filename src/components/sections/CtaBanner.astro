---
import Button from "@/components/Button.astro";

interface Props {
  title?: string;
  description?: string;
  buttonLabel?: string;
}

const {
  title = "Prêt·e à prendre un temps pour vous ?",
  description = "Le premier échange permet de faire connaissance et de voir ensemble si la sophrologie répond à votre besoin.",
  buttonLabel = "Prendre rendez-vous",
} = Astro.props;
---

<section class="section-padding">
  <div class="container-site">
    <div
      class="flex flex-col items-center gap-6 rounded-3xl bg-sand-100 px-8 py-14 text-center sm:px-16"
    >
      <h2 class="max-w-xl text-3xl font-medium text-sage-900 sm:text-4xl">
        {title}
      </h2>
      <p class="max-w-md text-sage-700">
        {description}
      </p>
      <Button href="/#contact" variant="primary">{buttonLabel}</Button>
    </div>
  </div>
</section>
