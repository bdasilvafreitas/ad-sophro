---
import SectionHeading from "@/components/SectionHeading.astro";
import { FAQ_ITEMS } from "@/data/faq";

// Seules les questions dont la réponse est finalisée alimentent les données
// structurées, pour ne jamais publier de contenu "__A_COMPLETER__" en JSON-LD.
const answeredItems = FAQ_ITEMS.filter((item) => item.answer !== "__A_COMPLETER__");

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: answeredItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<section id="faq" class="section-padding bg-sage-50">
  <div class="container-site">
    <SectionHeading eyebrow="Questions fréquentes" title="Tout ce que vous vous demandez" />

    <div class="mx-auto mt-14 max-w-3xl divide-y divide-sage-200 rounded-2xl border border-sage-200 bg-cream-50">
      {
        FAQ_ITEMS.map((item) => (
          <details class="group p-6">
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-sage-900 marker:content-none [&::-webkit-details-marker]:hidden"
            >
              {item.question}
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
                class="shrink-0 text-sand-700 transition-transform duration-200 group-open:rotate-45"
              >
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
              </svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-sage-700">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
</section>
