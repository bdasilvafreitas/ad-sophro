---
import SectionHeading from "@/components/SectionHeading.astro";
import ToComplete from "@/components/ToComplete.astro";
import { SITE } from "@/data/site";

const INFO = [
  { label: "Adresse du cabinet", value: SITE.contact.address },
  { label: "Horaires", value: SITE.contact.hours },
  { label: "Téléphone", value: SITE.contact.phone },
  { label: "Email", value: SITE.contact.email },
] as const;
---

<section id="infos-pratiques" class="section-padding">
  <div class="container-site grid gap-12 lg:grid-cols-2 lg:items-start">
    <div>
      <SectionHeading align="left" eyebrow="Informations pratiques" title="Où et quand" />

      <dl class="mt-8 space-y-5">
        {
          INFO.map((item) => (
            <div class="flex flex-col gap-1 border-b border-sage-200 pb-4 sm:flex-row sm:items-center sm:justify-between">
              <dt class="text-sm font-medium text-sage-600">{item.label}</dt>
              <dd class="text-base text-sage-900">
                {item.value === "__A_COMPLETER__" ? <ToComplete label={item.label} /> : item.value}
              </dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-6 text-sm text-sage-600">
        Cabinet basé en {SITE.zone}. Séances possibles en présentiel
        {" "}<ToComplete label="modalités : présentiel / visio / à domicile" />.
      </p>
    </div>

    <div
      class="flex aspect-[4/3] w-full flex-col items-center justify-center gap-3 rounded-2xl border border-dashed border-sage-300 bg-sage-50 p-8 text-center"
      role="img"
      aria-label="Emplacement réservé à une carte de localisation du cabinet"
    >
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-sage-500">
        <path
          d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z"
          stroke="currentColor"
          stroke-width="1.6"
        ></path>
        <circle cx="12" cy="9.5" r="2.4" stroke="currentColor" stroke-width="1.6"></circle>
      </svg>
      <p class="max-w-xs text-sm text-sage-600">
        La carte d'accès au cabinet sera bientôt disponible ici.
      </p>
    </div>
  </div>
</section>
