---
import SectionHeading from "@/components/SectionHeading.astro";
import ToComplete from "@/components/ToComplete.astro";
import Button from "@/components/Button.astro";

const ROWS = [
  { label: "Séance individuelle (1re séance)" },
  { label: "Séance individuelle (suivi)" },
  { label: "Séance de groupe" },
  { label: "Forfait / abonnement" },
] as const;
---

<section id="tarifs" class="section-padding bg-sage-50">
  <div class="container-site">
    <SectionHeading eyebrow="Tarifs" title="Investir dans son bien-être" />

    <div class="mx-auto mt-14 max-w-2xl overflow-hidden rounded-2xl border border-sage-200 bg-cream-50">
      <table class="w-full text-left">
        <caption class="sr-only">Grille tarifaire des séances de sophrologie</caption>
        <thead>
          <tr class="border-b border-sage-200 bg-sage-100/60">
            <th scope="col" class="px-6 py-4 text-sm font-semibold text-sage-800">Prestation</th>
            <th scope="col" class="px-6 py-4 text-sm font-semibold text-sage-800">Tarif</th>
          </tr>
        </thead>
        <tbody>
          {
            ROWS.map((row) => (
              <tr class="border-b border-sage-100 last:border-none">
                <td class="px-6 py-4 text-sage-800">{row.label}</td>
                <td class="px-6 py-4">
                  <ToComplete />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mx-auto mt-6 max-w-lg text-center text-sm text-sage-600">
      Certaines mutuelles proposent une prise en charge partielle sous forme de forfait bien-être :
      renseignez-vous auprès de votre organisme.
    </p>

    <div class="mt-8 text-center">
      <Button href="#contact" variant="ghost">Demander un devis</Button>
    </div>
  </div>
</section>
