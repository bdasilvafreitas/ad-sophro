---
import Button from "@/components/Button.astro";
import { SITE } from "@/data/site";
---

<section id="accueil" class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-sage-100 blur-2xl"></div>
    <div class="absolute top-1/3 -left-32 h-72 w-72 rounded-full bg-sand-100 blur-2xl"></div>
  </div>

  <div class="container-site grid items-center gap-12 py-20 sm:py-28 lg:grid-cols-2 lg:py-32">
    <div>
      <p class="mb-5 font-sans text-xs font-semibold tracking-[0.25em] text-sand-800 uppercase">
        {SITE.zone}
      </p>
      <h1 class="text-4xl leading-tight font-medium text-sage-900 sm:text-5xl lg:text-6xl">
        Retrouver son calme intérieur,<br class="hidden sm:block" />
        <span class="font-script text-5xl text-sage-700 sm:text-6xl lg:text-7xl">pas à pas</span>
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-sage-700">
        Séances de sophrologie avec {SITE.practitionerName}, pour apprendre à mieux gérer votre stress,
        vos émotions et retrouver confiance, à votre rythme.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href="#contact" variant="primary">Prendre rendez-vous</Button>
        <Button href="#sophrologie" variant="ghost">Découvrir la sophrologie</Button>
      </div>
    </div>

    <div class="relative mx-auto aspect-square w-full max-w-md">
      <div
        class="flex h-full w-full items-center justify-center rounded-full border border-sage-300 bg-sage-50"
      >
        <svg viewBox="0 0 200 200" class="h-2/3 w-2/3" aria-hidden="true">
          <circle cx="100" cy="100" r="78" fill="none" stroke="#AEC0B5" stroke-width="1" />
          <path
            d="M100 58c-16 11-28 27-28 46 0 19 12.5 31 28 31s28-12 28-31c0-19-12-35-28-46Z"
            fill="none"
            stroke="#4F6259"
            stroke-width="2.4"
            stroke-linecap="round"
          ></path>
          <circle cx="100" cy="48" r="11" fill="none" stroke="#B98F63" stroke-width="2.2" />
        </svg>
      </div>
      <!--
        Mark provisoire (voir src/components/Logo.astro). Remplacer par le
        vrai logo / une photo professionnelle dès que disponible.
      -->
    </div>
  </div>
</section>
